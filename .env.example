# Copy to .env and fill in. .env is gitignored; never commit real keys.

# NGC API key. Required to pull nvcr.io images and to run the NIM container.
# Create one at https://ngc.nvidia.com -> Setup -> Generate API Key
NGC_API_KEY=

# Hugging Face token. Only needed for gated weights such as the Llama models.
# Request access on the model page first, then create a token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases key. Optional. Training and evaluation run without it;
# you lose the dashboards. https://wandb.ai/authorize
WANDB_API_KEY=
