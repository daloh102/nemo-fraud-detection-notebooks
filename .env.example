# Copy to .env and fill in. .env is gitignored; never commit real keys.

# NGC API key. Required to pull nvcr.io images and to run the NIM container.
# Create one at https://ngc.nvidia.com -> Setup -> Generate API Key
NGC_API_KEY=

# Hugging Face token. Only needed for gated weights such as the Llama models.
# Request access on the model page first, then create a token at
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases key. Optional. Training and evaluation run without it;
# you lose the dashboards. https://wandb.ai/authorize
WANDB_API_KEY=

# Repo root as mounted inside the containers. Leave as-is unless you changed
# the bind mount path in docker-compose.yml.
PROJECT_ROOT=/data/nemo-fraud-detection-notebooks

# NIM's OpenAI-compatible endpoint. Leave as-is when using docker-compose;
# override only if you run NIM elsewhere.
NIM_BASE_URL=http://nim-llama3:8000/v1
