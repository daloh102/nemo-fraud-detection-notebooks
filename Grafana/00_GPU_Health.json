            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus",
                        "uid": "prometheus",
                        "type": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "DCGM_FI_DEV_SM_CLOCK_HERTZ{hostname=~\".*\", gpu=~\".*\"} * 1000000",
